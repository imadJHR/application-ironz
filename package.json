{
  "name": "ironz-gestion",
  "version": "0.1.2",
  "private": true,
  "scripts": {
    "predev": "prisma generate",
    "dev": "next dev --hostname 127.0.0.1",
    "prebuild": "prisma generate",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:import-products": "node scripts/import-products.mjs",
    "pretest:setup": "prisma generate",
    "test:e2e": "node --env-file=.env.test.local node_modules/@playwright/test/cli.js test",
    "test:setup": "node scripts/e2e-setup.mjs",
    "format": "prettier --write src tests scripts *.json *.ts *.mjs README.md",
    "format:check": "prettier --check src tests scripts *.json *.ts *.mjs README.md"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "6.19.2",
    "@radix-ui/react-slot": "^1.2.3",
    "@react-pdf/renderer": "^4.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "lucide-react": "^0.577.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.62.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.34.0",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.9.9",
    "prisma": "6.19.2",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": "^22.16.0 || >=23.8.0"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "^8.0.0",
      "effect": "^3.20.0"
    }
  }
}
